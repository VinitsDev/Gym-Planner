<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Toolbar com voltar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#000000">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@null"
            android:contentDescription="Voltar"
            android:layout_marginEnd="16dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="Logo"
            android:layout_marginEnd="16dp" />

        <ImageView
            android:id="@+id/btnConfiguracoes"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="Configurações" />

    </LinearLayout>

    <!-- Conteúdo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etSplitNome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nome do Treino"
                android:inputType="textCapWords"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#444444"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etSplitDescricao"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Descrição"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#444444"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lista de Exercícios do Treino:"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <ListView
                android:id="@+id/lvExerciciosSplit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0dp" />

            <Button
                android:id="@+id/btnAdicionarExercicio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1A1A1A"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Botão criar fixo -->
    <Button
        android:id="@+id/btnCriarSplit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="CRIAR"
        android:textColor="#000000"
        android:backgroundTint="#FFFFFF"
        android:textStyle="bold"
        android:layout_margin="16dp" />

</LinearLayout>