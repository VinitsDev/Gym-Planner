<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#000000">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Treinamentos"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="Logo"
            android:layout_marginEnd="16dp" />

        <ImageView
            android:id="@+id/btnConfiguracoes"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="Configurações" />

    </LinearLayout>

    <!-- Botão criar novo treino -->
    <Button
        android:id="@+id/btnCriarNovoSplit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Criar novo Treinamento!"
        android:textColor="#000000"
        android:backgroundTint="#FFFFFF"
        android:textStyle="bold"
        android:layout_margin="16dp" />

    <!-- Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lista de treinamentos:"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:paddingStart="16dp"
        android:paddingBottom="8dp" />

    <!-- Lista de Splits -->
    <ListView
        android:id="@+id/lvSplitList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#111111"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnNavTreino"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_upload"
            android:background="@null"
            android:contentDescription="Iniciar Treino" />

        <ImageButton
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_agenda"
            android:background="@null"
            android:contentDescription="Home" />

        <ImageButton
            android:id="@+id/btnNavPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_myplaces"
            android:background="@null"
            android:contentDescription="Perfil" />

    </LinearLayout>

</LinearLayout>